APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=it_learns
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ──────────────────────────────────────────────────────────────────
# Payment (Этап 3 — InstantPaymentGateway, см. docs/concept.md §9.2.2)
# ──────────────────────────────────────────────────────────────────
# Payment-провайдер для подписок. На dev можно оставить пустыми;
# реквизиты провайдера заполняются при подключении реального шлюза.
PAYMENT_PROVIDER=instant
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ──────────────────────────────────────────────────────────────────
# AI / LLM (Этап 4 — см. AGENTS.md правило №16, docs/concept.md §2.3)
# ──────────────────────────────────────────────────────────────────
# Single-tenant: один провайдер выбирается через .env
# (см. docs/concept.md §9.2.5). Whitelist реализаций:
# openai, anthropic, minimax, openai-compatible, dummy.
# Для dev/тестов оставьте LLM_PROVIDER=dummy.
LLM_PROVIDER=dummy
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Лимиты токенов (правило №16 AGENTS.md).
# Глобальный лимит на платформу за день; per-user — для каждого юзера.
AI_TOKEN_LIMIT_GLOBAL_PER_DAY=1000000
AI_TOKEN_LIMIT_PER_USER_PER_DAY=50000

# ──────────────────────────────────────────────────────────────────
# Mail (прод)
# ──────────────────────────────────────────────────────────────────
# На dev — MAIL_MAILER=log (см. выше в этом файле), письма в
# storage/logs/laravel.log.
# На проде администратор указывает SMTP-параметры самостоятельно
# (.env / деплой-конфиг). Выбор провайдера и реквизиты — НЕ наша
# задача (см. AGENTS.md §Этап 0, Этап 1 §"Готовность").

# ──────────────────────────────────────────────────────────────────
# Test Database (см. AGENTS.md §3.1)
# ──────────────────────────────────────────────────────────────────
# Тестовая БД живёт в Docker-контейнере `db-testing` (см. docker-compose.yml).
# `composer test` сам поднимает контейнер и делает `migrate:fresh --env=testing`.
# Эти переменные — fallback, если разработчик хочет прогнать тесты вручную
# (`docker compose --profile testing up -d db-testing` + `php artisan test`).
# Реальный source of truth — phpunit.xml <env> блок.
DB_TEST_HOST=127.0.0.1
DB_TEST_PORT=3317
DB_TEST_DATABASE=it_learns_test
DB_TEST_USERNAME=root
DB_TEST_PASSWORD=

# ──────────────────────────────────────────────────────────────────
# Admin-аккаунт (см. database/seeders/AdminSeeder.php)
# ──────────────────────────────────────────────────────────────────
# Создаётся через `php artisan db:seed --class=AdminSeeder` (или внутри
# `php artisan migrate:fresh --seed`). Оставьте ADMIN_PASSWORD пустым,
# чтобы при первом сидинге сгенерировался случайный пароль — он будет
# записан в storage/logs/laravel.log с префиксом "AdminSeeder:".
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
