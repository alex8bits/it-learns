APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:28080

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=it_learns
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Очередь (database-драйвер). Превью курсов после загрузки конвертируются
# в WebP фоновым job'ом ConvertCoursePreviewToWebp: нужен запущенный
# воркер — `composer dev` поднимает `php artisan queue:listen --tries=1`.
# Без воркера превью остаются в исходном формате (graceful degradation).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ──────────────────────────────────────────────────────────────────
# Payment (Этапы 3/9 — см. docs/platform-plan.md Этап 3,
# docs/progress-plan.md Этап 9)
# ──────────────────────────────────────────────────────────────────
# Payment-провайдер для подписок. Whitelist = dummy | yookassa.
# dummy (DummyPaymentGateway) — фиктивный гейт без реальной оплаты
# (премиум выдаётся сразу; dev/тесты/демо). Боевой гейт включается
# PAYMENT_PROVIDER=yookassa (YooKassaPaymentGateway — прямой HTTP,
# без SDK; креденшалы обязательны, иначе fail-loud на boot).
# Тестовый мерчант ЮKassa = отдельные креденшалы тестового магазина.
# Webhook-секрета у ЮKassa нет: уведомления не подписываются, тело
# перепроверяется re-fetch'ем через API ЮKassa.
PAYMENT_PROVIDER=dummy
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ──────────────────────────────────────────────────────────────────
# AI / LLM (Этап 4 — см. AGENTS.md правило №16, docs/concept.md §2.3)
# ──────────────────────────────────────────────────────────────────
# Single-tenant: один провайдер выбирается через .env
# (см. docs/concept.md §9.2.5). Whitelist реализаций:
# openai, anthropic, minimax, openai_compatible, dummy.
# Для dev/тестов оставьте AI_PROVIDER=dummy.
AI_PROVIDER=dummy
AI_API_KEY=
AI_MODEL=
# Base URL — только для openai_compatible; валидируется на старте
# (формат URL + блокировка внутренних адресов — SSRF-защита).
AI_BASE_URL=

# Лимиты токенов (правило №16 AGENTS.md).
# Глобальный лимит на платформу за день; per-user — для каждого юзера.
AI_TOKEN_LIMIT_GLOBAL_PER_DAY=100000
AI_TOKEN_LIMIT_PER_USER_PER_DAY=5000

# Только для dev: полный текст промпта в логи (в production не
# включать: риск утечки + раздувание storage).
AI_LOG_FULL_PROMPTS=false

# ──────────────────────────────────────────────────────────────────
# Practice (Этапы 5/10 — см. docs/platform-plan.md Этапы 5 и 10)
# ──────────────────────────────────────────────────────────────────
# Драйвер изоляции среды практики (whitelist в config/practice.php).
# local-sqlite = одноразовый SQLite-файл на попытку (Этап 5, без Docker).
# docker = эфемерные Docker-контейнеры per-attempt (Этап 10): задания
# с рантаймами mysql/postgres исполняются в официальных образах
# mysql:8/postgres:16 (нужен запущенный Docker Desktop / docker-демон;
# первый запуск тянет образ — это долго). Конфиг docker-драйвера
# валидируется на boot: неполный practice.docker = fail-loud.
PRACTICE_DRIVER=local-sqlite
# Лимиты SQLite-рантайма (можно перезаписать при необходимости):
# таймаут запроса (сек), макс. размер JSON-результата и макс. размер
# файла БД (байт; движковый лимит через PRAGMA max_page_count).
# PRACTICE_SQLITE_TIMEOUT_SECONDS=5
# PRACTICE_SQLITE_MAX_RESULT_BYTES=1048576
# PRACTICE_SQLITE_MAX_DB_BYTES=104857600
# Настройки docker-драйвера (актуальны при PRACTICE_DRIVER=docker):
# путь к docker-бинарю; лимиты контейнера (память МБ, CPU, PIDs);
# таймаут запроса (сек; docker exec жёстко убивается чуть позже);
# макс. размер вывода двигателя (байт); макс. число SQL-инструкций
# в одном решении (мульти-стейтменты — одна client-сессия движка);
# бюджет provision-цикла (readiness + seed, сек — бут mysql:8
# занимает 10-30 с); TTL подчистки висящих контейнеров (мин).
# PRACTICE_DOCKER_BINARY=docker
# PRACTICE_DOCKER_MEMORY_MB=512
# PRACTICE_DOCKER_CPUS=0.5
# PRACTICE_DOCKER_PIDS_LIMIT=128
# PRACTICE_DOCKER_TIMEOUT_SECONDS=20
# PRACTICE_DOCKER_MAX_RESULT_BYTES=1048576
# PRACTICE_DOCKER_MAX_STATEMENTS=20
# PRACTICE_DOCKER_PROVISION_TIMEOUT_SECONDS=60
# PRACTICE_DOCKER_PRUNE_TTL_MINUTES=30
# Анти-DoS цикла практики (Этап 10): TTL лок-ов попытки (сек) — покрывает
# худший случай цикла (бут mysql-контейнера 10-30 с + таймаут исполнения
# + маржа) и само-истекает при жёстком краше процесса. Глобальный лимит
# параллельных сред (слоты practice-slot:{i}); не задано/пусто = без
# глобального лимита (поведение до Этапа 10) — docker-инсталляции
# выставляют осознанно (например, 2).
# PRACTICE_ENV_LOCK_TTL_SECONDS=120
# PRACTICE_MAX_CONCURRENT_ENVIRONMENTS=2

# ──────────────────────────────────────────────────────────────────
# Mail (прод)
# ──────────────────────────────────────────────────────────────────
# На dev — MAIL_MAILER=log (см. выше в этом файле), письма в
# storage/logs/laravel.log.
# На проде администратор указывает SMTP-параметры самостоятельно
# (.env / деплой-конфиг). Выбор провайдера и реквизиты — НЕ наша
# задача (см. AGENTS.md §Этап 0, Этап 1 §"Готовность").

# ──────────────────────────────────────────────────────────────────
# Test Database (см. AGENTS.md §3.1)
# ──────────────────────────────────────────────────────────────────
# Тестовая БД живёт в Docker-контейнере `db-testing` (см. docker-compose.yml).
# `composer test` сам поднимает контейнер и делает `migrate:fresh --env=testing`.
# Эти переменные — fallback, если разработчик хочет прогнать тесты вручную
# (`docker compose --profile testing up -d db-testing` + `php artisan test`).
# Реальный source of truth — phpunit.xml <env> блок.
DB_TEST_HOST=127.0.0.1
DB_TEST_PORT=23307
DB_TEST_DATABASE=it_learns_test
DB_TEST_USERNAME=root
DB_TEST_PASSWORD=

# ──────────────────────────────────────────────────────────────────
# Admin-аккаунт (см. database/seeders/AdminSeeder.php)
# ──────────────────────────────────────────────────────────────────
# Создаётся через `php artisan db:seed --class=AdminSeeder` (или внутри
# `php artisan migrate:fresh --seed`). Оставьте ADMIN_PASSWORD пустым,
# чтобы при первом сидинге сгенерировался случайный пароль — он будет
# записан в storage/logs/laravel.log с префиксом "AdminSeeder:".
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
